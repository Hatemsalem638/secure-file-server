<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.javafxapplication1.EncryptionController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Choose a file to encrypt (AES-256-GCM) or decrypt" />
            <TextField fx:id="filename" prefWidth="200.0" />
            <Button fx:id="browse" mnemonicParsing="false" onAction="#handleBrowse" text="Browse" />
         </children>
      </HBox>
   </top>
   <center>
      <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
         <children>
            <Label fx:id="label" text="Selected file is : " />
         </children>
      </HBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Button fx:id="enc" disable="true" mnemonicParsing="false" onAction="#handleEncrypt" text="Encrypt" />
            <Button fx:id="denc" disable="true" mnemonicParsing="false" onAction="#handleDecrypt" text="Decrypt" />
            <Button fx:id="cancel" mnemonicParsing="false" onAction="#handleCancel" text="Close" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
