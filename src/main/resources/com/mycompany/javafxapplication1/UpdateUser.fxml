<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="313.0" prefWidth="604.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.javafxapplication1.UpdateUserController">
   <children>
      <VBox alignment="CENTER" layoutX="189.0" layoutY="101.0" spacing="10.0">
         <children>
            <Label text="Update User Password" />
            <TextField fx:id="usernameField" onKeyPressed="#handleEnterKeyPressed" promptText="Username" />
            <PasswordField fx:id="oldPasswordField" onKeyPressed="#handleEnterKeyPressed" promptText="Old Password" />
            <PasswordField fx:id="newPasswordField" onKeyPressed="#handleEnterKeyPressed" promptText="New Password" />

            <Button fx:id="updateuserButton" mnemonicParsing="false" onAction="#updateUserPassword" text="Update" />
            <Label fx:id="statusLabel" textFill="RED" />
         </children>
      </VBox>
   </children>
</AnchorPane>
