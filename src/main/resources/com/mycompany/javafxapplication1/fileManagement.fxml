<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.javafxapplication1.FileManagmentController">
    <children>
        <Button layoutX="267.0" layoutY="176.0" mnemonicParsing="false" onAction="#goBackHandler" text="Go Back" />
        <TextField fx:id="fileNameTextField" layoutX="129.0" layoutY="50.0" promptText="File Name" />
        <TextArea fx:id="fileContentTextArea" layoutX="129.0" layoutY="89.0" prefHeight="172.0" prefWidth="341.0" promptText="File Content" />
      <GridPane layoutX="172.0" layoutY="288.0" prefHeight="90.0" prefWidth="361.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="158.0" minWidth="10.0" prefWidth="126.0" />
          <ColumnConstraints hgrow="SOMETIMES" maxWidth="115.0" minWidth="10.0" prefWidth="115.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
              <Button fx:id="EncryptionButton" mnemonicParsing="false" onAction="#goToEncyptionPage" prefHeight="24.0" prefWidth="119.0" text="Encrypt" GridPane.columnIndex="1" />
              <Button fx:id="deleteFileButton" mnemonicParsing="false" onAction="#deleteFileHandler" prefHeight="24.0" prefWidth="119.0" text="Delete File" GridPane.columnIndex="1" GridPane.rowIndex="2" />
              <Button fx:id="saveFileButton" mnemonicParsing="false" onAction="#saveFile" prefHeight="24.0" prefWidth="135.0" text="Save File" GridPane.rowIndex="2" />
              <Button fx:id="loadFileButton" mnemonicParsing="false" onAction="#loadFile" prefHeight="27.0" prefWidth="142.0" text="Load File" />
         </children>
      </GridPane>
    </children>
</AnchorPane>
